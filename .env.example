# Docker local design; supply real secrets outside Git.
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://127.0.0.1:8080
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ternava
DB_USERNAME=ternava
DB_PASSWORD=changeme
QUEUE_CONNECTION=database
SESSION_DRIVER=array
FILESYSTEM_DISK=private
SANCTUM_EXPIRATION=10080
OFFLINE_LEASE_HOURS=24
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=/run/secrets/fcm-service-account.json
BACKUP_ENCRYPTION_KEY=your_key_here
