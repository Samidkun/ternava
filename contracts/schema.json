    "transactions": [
      "draft + outbox",
      "ack + accepted cache + outbox state",
      "delta changes + cursor"
    ],
    "payload_protection": "AES-256-GCM via maintained library; random nonce per write; actor/farm/object/schema version as associated data; key in platform secure storage"
  },
  "global_constraints": [
    "Every referenced business object is in the current farm; validate polymorphic references too",
    "No hard delete of accepted ledgers/operational records during pilot",
    "Global lock order: farm sync counter -> flock(s sorted UUID) -> daily/task/incident row -> feed balance(s sorted UUID) -> receipt; bounded transaction retry",
    "All instants UTC timestamptz; business_date is farm local DATE",
    "Append-only snapshots retained for bootstrap as-of watermark; cache queries exclude other users inbox"
  ]
